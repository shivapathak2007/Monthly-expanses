PORT=5001
NODE_ENV=development

# Supabase Configuration
# Fill in your Supabase project URL and keys to connect to Supabase PostgreSQL.
# If left blank, SpendWise automatically runs in resilient local SQLite mode for development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Authentication
JWT_SECRET=spendwise_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173
