PORT=5001
NODE_ENV=development

# Supabase Configuration (Primary Persistent PostgreSQL Database)
# Fill in your Supabase project URL and keys to connect to Supabase PostgreSQL.
# If left blank, Kharcha automatically runs in resilient local SQLite mode for development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Authentication
JWT_SECRET=kharcha_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# Optional: Google Cloud Storage (For future large export & backup archiving)
# Leave blank to use primary Supabase storage provider
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_CREDENTIALS=
